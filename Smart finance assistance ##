        "# 🤖 AI Collaboration: Spending Analysis Function\n",
        "# Ask AI to help you create comprehensive spending analysis\n",
        "\n",
        "def analyze_spending_patterns(df):\n",
        "    \"\"\"\n",
        "    Analyze spending patterns and generate business insights\n",
        "\n",
        "    🤖 AI Collaboration Prompt:\n",
        "    \"Create a function that analyzes spending by category, calculates percentages,\n",
        "    identifies top spending areas, and generates actionable financial insights\n",
        "    formatted for business presentation.\"\n",
        "\n",
        "    Args:\n",
        "        df: Cleaned transaction DataFrame\n",
        "    Returns:\n",
        "        dict: Analysis results and insights\n",
        "    \"\"\"\n",
        "    analysis_results = {}\n",
        "\n",
        "    # Calculate total spending (excluding refunds for positive spending analysis)\n",
        "    total_positive_spending = df[df['Amount'] > 0]['Amount'].sum()\n",
        "    total_spending = df['Amount'].sum()\n",
        "    analysis_results['total_spending'] = total_spending\n",
        "    analysis_results['total_positive_spending'] = total_positive_spending\n",
        "\n",
        "    # Group by category and calculate sum\n",
        "    spending_by_category = df.groupby('Category')['Amount'].sum().sort_values(ascending=False)\n",
        "    analysis_results['spending_by_category'] = spending_by_category.to_dict()\n",
        "\n",
        "    # Calculate percentages for positive spending categories\n",
        "    category_percentages = {}\n",
        "    if total_positive_spending > 0:\n",
        "        for category, amount in spending_by_category.items():\n",
        "            if amount > 0: # Only consider positive spending for percentages\n",
        "                category_percentages[category] = (amount / total_positive_spending) * 100\n",
        "    analysis_results['category_percentages'] = category_percentages\n",
        "\n",
        "    # Identify top spending areas (based on positive spending)\n",
        "    top_spending_areas = {k: v for k, v in sorted(category_percentages.items(), key=lambda item: item[1], reverse=True) if v > 0}\n",
        "    analysis_results['top_spending_areas'] = top_spending_areas\n",
        "\n",
        "    # Generate basic insights\n",
        "    insights = []\n",
        "    if 'Refund' in spending_by_category and spending_by_category['Refund'] < 0:\n",
        "        insights.append(f\"You received a total of ${-spending_by_category['Refund']:.2f} in refunds.\")\n",
        "\n",
        "    if top_spending_areas:\n",
        "        most_spent_category = list(top_spending_areas.keys())[0]\n",
        "        most_spent_percentage = top_spending_areas[most_spent_category]\n",
        "        insights.append(f\"Your largest spending category is '{most_spent_category}' accounting for {most_spent_percentage:.2f}% of your positive expenditure.\")\n",
        "\n",
        "    if total_positive_spending > 0:\n",
        "        insights.append(f\"Your total positive spending is ${total_positive_spending:.2f}.\")\n",
        "\n",
        "    analysis_results['insights'] = insights\n",
        "\n",
        "    # Format for business presentation\n",
        "    formatted_output = \"### Spending Analysis Report\\n\\n\"\n",
        "    formatted_output += f\"Total Overall Spending (including refunds): ${total_spending:.2f}\\n\"\n",
        "    formatted_output += f\"Total Positive Spending (excluding refunds): ${total_positive_spending:.2f}\\n\\n\"\n",
